{
  "name": "erlc-api",
  "version": "4.0.0",
  "description": "Modern, type-safe ER:LC Private Server API client for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./maps": {
      "types": "./dist/maps.d.ts",
      "import": "./dist/maps.js",
      "default": "./dist/maps.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "auth": [
        "dist/auth.d.ts"
      ],
      "maps": [
        "dist/maps.d.ts"
      ],
      "webhooks": [
        "dist/webhooks.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README_ES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.8"
  },
  "packageManager": "pnpm@11.19.0",
  "keywords": [
    "erlc",
    "roblox",
    "prc",
    "erlc-api",
    "liberty-county"
  ],
  "author": "egologics",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node ./scripts/clean.mjs",
    "lint": "biome check src tests examples scripts",
    "format": "biome format --write src tests examples scripts",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "pnpm run build && node --test tests/client.test.mjs tests/helpers.test.mjs tests/intellisense.test.mjs",
    "typecheck": "tsc -p tsconfig.types-test.json",
    "test:types": "pnpm run typecheck",
    "check": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exodo0/ERLC-API.git"
  },
  "bugs": {
    "url": "https://github.com/Exodo0/ERLC-API/issues"
  },
  "homepage": "https://github.com/Exodo0/ERLC-API#readme"
}
